# Normalise line endings: LF in the repo and in working copies on every OS.
* text=auto eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.db binary

# Windows batch files need CRLF line endings
*.cmd text eol=crlf
*.bat text eol=crlf
